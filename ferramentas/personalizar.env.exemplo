# Valores da sua instituicao para ferramentas/personalizar.sh.
# Copie para personalizar.env (ignorado pelo Git) e ajuste.
# Linhas comentadas usam o padrao indicado, derivado de DOMINIO.

# Dominio base dos sistemas e sites (obrigatorio)
DOMINIO=minhainstituicao.edu.br

# Registry de imagens e servidor Git
#REGISTRY=registry.minhainstituicao.edu.br
#GIT_HOST=git.minhainstituicao.edu.br

# Grupos/organizacoes no Git e no registry
#GRUPO_DEV=dev          # equipe que constroi as imagens
#GRUPO_INFRA=infra      # equipe que opera os manifestos (tambem o @ do CODEOWNERS)
#GRUPO_TEMAS=temas      # equipe que publica a imagem de temas do WordPress

# Enderecos do GLPI (host do Ingress de cada ambiente)
#GLPI_HOST_PROD=glpi.minhainstituicao.edu.br
#GLPI_HOST_HML=glpi.homologa.minhainstituicao.edu.br
#GLPI_HOST_TESTE=glpi.teste.minhainstituicao.edu.br

# Armazenamento NFS
NFS_SERVER=192.0.2.10
#NFS_EXPORT=/exports

# CIDR de pods onde roda o ingress controller (confianca do real_ip no nginx)
#POD_CIDR=10.244.0.0/16

# E-mail
#SMTP_HOST=smtp.minhainstituicao.edu.br
#EMAIL_REMETENTE=naoresponda@minhainstituicao.edu.br
#EMAIL_CI=ci@minhainstituicao.edu.br
